<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Event Dashboard</title>
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f9;
            color: #333;
            margin: 0;
            padding: 0;
        }

        header {
            background-color: #007bff;
            color: #fff;
            padding: 20px 0;
            text-align: center;
            margin-bottom: 20px;
        }

        header h1 {
            margin: 0;
            font-size: 2rem;
        }

        nav {
            margin-top: 10px;
        }

        .btn {
            display: inline-block;
            padding: 10px 15px;
            color: #fff;
            background-color: #28a745;
            border: none;
            border-radius: 5px;
            text-decoration: none;
            text-align: center;
            font-size: 1rem;
            transition: background-color 0.3s ease;
        }

        .btn:hover {
            background-color: #218838;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        .events-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
        }

        .event-card {
            background: #fff;
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .event-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 10px rgba(0, 0, 0, 0.15);
        }

        .event-card h2 {
            margin-top: 0;
            color: #007bff;
        }

        .event-card p {
            margin: 10px 0;
        }

        .card-actions {
            margin-top: 10px;
        }

        .card-actions .btn {
            margin-right: 10px;
        }

        .delete-btn {
            background-color: #dc3545;
        }

        .delete-btn:hover {
            background-color: #c82333;
        }

        .edit-btn {
            background-color: #ffc107;
        }

        .edit-btn:hover {
            background-color: #e0a800;
        }

        p {
            font-size: 1rem;
            text-align: center;
        }

        a {
            color: #007bff;
            text-decoration: none;
            transition: color 0.3s ease;
        }

        a:hover {
            color: #0056b3;
        }
    </style>
</head>
<body>
    <header>
        <h1>Event Dashboard</h1>
        <nav>
            <a href="/add" class="btn">Add Event</a>
        </nav>
    </header>
    <section class="container">
        <% if (events.length > 0) { %>
            <div class="events-grid">
                <% events.forEach(event => { %>
                    <div class="event-card">
                        <h2><%= event.name %></h2>
                        <p><strong>Date:</strong> <%= new Date(event.date).toDateString() %></p>
                        <p><%= event.description %></p>
                        <div class="card-actions">
                            <a href="/edit/<%= event._id %>" class="btn edit-btn">Edit</a>
                            <form action="/delete/<%= event._id %>" method="POST" class="inline-form">
                                <button type="submit" class="btn delete-btn">Delete</button>
                            </form>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <p>No events yet. <a href="/add">Add an event</a> to get started!</p>
        <% } %>
    </section>
</body>
</html>
